# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars

# ── URLs (required in production) ────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_URL=https://your-frontend-domain.com
# The publicly reachable URL of this backend server
SERVER_URL=https://your-backend-domain.com
# The URL of the ML service (internal or public)
ML_SERVICE_URL=https://your-ml-service-domain.com

# ── Cloudinary (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── PhonePe (payments) ───────────────────────────────────────────────────────
# Sandbox: https://api-preprod.phonepe.com/apis/pg-sandbox
# Production: https://api.phonepe.com/apis/hermes
PHONEPE_HOST=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
